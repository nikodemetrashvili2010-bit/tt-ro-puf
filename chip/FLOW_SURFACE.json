      "addresses": "any instance by name, one per line, name x y orient",
      "status_set": "FIRM",
      "status_source": "librelane/steps/odb.py passes --fixed; placers.py sets FIRM when it is given",
      "excludes": "MACROS",
      "excludes_detail": "the step writes placement.cfg from MACRO_PLACEMENT_CFG if it is set and from MACROS otherwise, an if/elif, so a cfg file must carry every macro instance the MACROS block would have placed",
      "deprecated": true,
      "runs_before": [
        "OpenROAD.CutRows",
        "OpenROAD.TapEndcapInsertion",
        "OpenROAD.GeneratePDN",
        "OpenROAD.GlobalPlacement"
      ]
    },
