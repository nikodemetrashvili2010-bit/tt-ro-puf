  "config_merge": {
    "_comment": [
      "tt-support-tools project.py create_merged_config: it reads",
      "src/config.json, then src/user_config.json, and the second",
      "overwrites the first key by key. So anything TT generates wins."
    ],
    "tt_generated_keys": [
      "DESIGN_NAME",
      "VERILOG_FILES",
      "DIE_AREA",
      "FP_DEF_TEMPLATE",
      "VDD_PIN",
      "GND_PIN",
      "RT_MAX_LAYER"
    ],
    "dir_prefix_resolves_to": "src/",
    "dir_prefix_note": "dir:: is relative to the config file, which is src/config.json, so a file this design hands the flow has to live in src/ and not in chip/"
  },
  "name_escaping": {
    "_comment": [
      "placers.py does not look an instance up by the name it is given. It",
      "calls reader.py's escape_verilog_name first, which puts a backslash",
      "in front of each bus bit character, so g_ro_bank[0] becomes",
      "g_ro_bank\\\\[0\\\\]. That is the DEF spelling, not the netlist one: the",
      "netlist escapes the whole identifier behind a single leading",
      "backslash. Mixing the two up cost a day in Phase E.",
      "So a cfg file carries names unescaped and lets the flow put its own",
      "escaping back."
    ],
    "rule": "re.sub(r'([BUSBITCHARS])', r'\\\\\\\\\\\\1', name)",
    "busbitchars_from": "the DEF, BUSBITCHARS \"[]\"",
    "source": "librelane/scripts/odbpy/reader.py, Reader.escape_verilog_name"
  },
